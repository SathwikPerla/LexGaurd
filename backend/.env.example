# ── LEXGUARD Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to git. .gitignore already excludes it.

# ── Anthropic Claude (LLM core) ───────────────────────────────────────────────
# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Base model for Agents 1, 3, 4 (Extractor, Reasoner, Negotiator).
# Default if unset: claude-sonnet-4-6
CLAUDE_MODEL_NAME=claude-sonnet-4-6

# Model for Agent 2 (Risk Analyzer) ONLY — the agent that makes the core risk
# judgments the whole report is built on. Defaults to Opus for higher accuracy.
# Set this equal to CLAUDE_MODEL_NAME to run the whole pipeline on one model.
RISK_ANALYZER_MODEL_NAME=claude-opus-4-8

# ── Google Cloud Platform ─────────────────────────────────────────────────────
# Path to your GCP service account key JSON file.
# The service account needs: Vertex AI User, Cloud Vision API User roles.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Your GCP project ID (the string ID, not the numeric project number).
VERTEX_AI_PROJECT_ID=your-gcp-project-id

# Vertex AI region. us-central1 is cheapest and has full Gemini 1.5 Pro access.
VERTEX_AI_LOCATION=us-central1

# Gemini model name. Do not change unless you are upgrading intentionally.
GEMINI_MODEL_NAME=gemini-1.5-pro-002

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for CORS.
# In production: set to your frontend Cloud Run URL.
ALLOWED_ORIGINS=http://localhost:3000

# Maximum upload file size in megabytes.
MAX_FILE_SIZE_MB=15

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Directory where ChromaDB persists its data.
# Default: ./chroma_db (relative to where uvicorn is started from)
CHROMA_DB_PATH=./chroma_db
